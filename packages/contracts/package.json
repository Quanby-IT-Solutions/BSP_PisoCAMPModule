{
	"name": "@repo/contracts",
	"version": "0.0.1",
	"description": "Contract-based API schemas and DTOs using Zod for type-safe validation and OpenAPI documentation.",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./pisocamp-assets": {
			"types": "./dist/modules/v1/pisocamp/asset.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/asset.schema.js"
		},
		"./pisocamp-preview": {
			"types": "./dist/modules/v1/pisocamp/preview.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/preview.schema.js"
		},
		"./pisocamp-version-history": {
			"types": "./dist/modules/v1/pisocamp/version-history.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/version-history.schema.js"
		},
		"./pisocamp-content-audit": {
			"types": "./dist/modules/v1/pisocamp/content-audit.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/content-audit.schema.js"
		},
		"./pisocamp-content": {
			"types": "./dist/modules/v1/pisocamp/content.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/content.schema.js"
		},
		"./pisocamp-analytics": {
			"types": "./dist/modules/v1/pisocamp/analytics.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/analytics.schema.js"
		},
		"./pisocamp-adoption": {
			"types": "./dist/modules/v1/pisocamp/adoption.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/adoption.schema.js"
		},
		"./pisocamp-progress": {
			"types": "./dist/modules/v1/pisocamp/progress.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/progress.schema.js"
		},
		"./pisocamp-leaderboard": {
			"types": "./dist/modules/v1/pisocamp/leaderboard.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/leaderboard.schema.js"
		},
		"./pisocamp-data-subject": {
			"types": "./dist/modules/v1/pisocamp/data-subject.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/data-subject.schema.js"
		},
		"./pisocamp-config": {
			"types": "./dist/modules/v1/pisocamp/pisocamp.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/pisocamp.schema.js"
		},
		"./pisocamp-account": {
			"types": "./dist/modules/v1/pisocamp/account.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/account.schema.js"
		},
		"./pisocamp-role": {
			"types": "./dist/modules/v1/pisocamp/role.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/role.schema.js"
		},
		"./pisocamp-report": {
			"types": "./dist/modules/v1/pisocamp/report.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/report.schema.js"
		},
		"./pisocamp-retention": {
			"types": "./dist/modules/v1/pisocamp/retention.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/retention.schema.js"
		},
		"./pisocamp-survey-response": {
			"types": "./dist/modules/v1/pisocamp/survey-response.schema.d.ts",
			"default": "./dist/modules/v1/pisocamp/survey-response.schema.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"format": "prettier --check \"src/**/*.ts\"",
		"format:fix": "prettier --write \"src/**/*.ts\"",
		"lint": "eslint --flag unstable_native_nodejs_ts_config \"src/**/*.ts\" --fix",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@orpc/contract": "catalog:",
		"@orpc/nest": "catalog:",
		"nestjs-zod": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/prettier-config": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "^4.1.2",
		"@vitest/ui": "^4.1.2",
		"eslint": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"vitest": "^4.1.2"
	},
	"prettier": "@repo/prettier-config"
}
