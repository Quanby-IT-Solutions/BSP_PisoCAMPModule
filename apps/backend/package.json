{
	"name": "@repo/backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"dev": "nest start --watch",
		"format": "prettier --check \"src/**/*.ts\"",
		"format:fix": "prettier --write \"src/**/*.ts\"",
		"start": "node dist/main.js",
		"lint": "eslint --flag unstable_native_nodejs_ts_config \"src/**/*.ts\" --fix",
		"test": "jest --runInBand",
		"test:watch": "jest --watch",
		"test:cov": "jest --runInBand --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nest-lab/throttler-storage-redis": "^1.2.0",
		"@nestjs/common": "catalog:",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "catalog:",
		"@nestjs/microservices": "^11.1.11",
		"@nestjs/platform-express": "^11.1.11",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^11.2.4",
		"@nestjs/terminus": "^11.0.0",
		"@nestjs/throttler": "^6.4.0",
		"@nestjs/websockets": "^11.1.6",
		"@orpc/contract": "catalog:",
		"@orpc/nest": "catalog:",
		"@orpc/openapi": "^1.13.4",
		"@orpc/server": "^1.13.4",
		"@orpc/zod": "^1.13.4",
		"@repo/auth": "workspace:*",
		"@repo/contracts": "workspace:*",
		"@repo/db": "workspace:*",
		"@repo/observability": "workspace:*",
		"@scalar/nestjs-api-reference": "^1.0.13",
		"@sentry/nestjs": "catalog:",
		"@t3-oss/env-core": "catalog:",
		"@thallesp/nestjs-better-auth": "^2.2.0",
		"better-auth": "catalog:",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"docx": "^9.7.1",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"exceljs": "^4.4.0",
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"ioredis": "^6.0.0",
		"lru-cache": "^11.0.0",
		"multer": "2.0.2",
		"nestjs-pino": "^4.6.1",
		"nestjs-zod": "^5.1.1",
		"pdfkit": "^0.20.2",
		"pg": "catalog:",
		"pino-http": "^11.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@jest/globals": "^30.4.1",
		"@nestjs/cli": "^11.0.14",
		"@nestjs/schematics": "^11.0.9",
		"@nestjs/testing": "^11.1.11",
		"@repo/eslint-config": "workspace:*",
		"@repo/prettier-config": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"@swc/cli": "^0.6.0",
		"@swc/core": "^1.11.0",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/multer": "2.0.0",
		"@types/node": "catalog:",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "catalog:",
		"@types/supertest": "^6.0.3",
		"cross-env": "^10.1.0",
		"eslint": "catalog:",
		"jest": "^30.2.0",
		"jszip": "^3.10.1",
		"pino-pretty": "^13.1.3",
		"prettier": "catalog:",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.6",
		"ts-loader": "^9.5.4",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"prettier": "@repo/prettier-config",
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.spec.json"
				}
			]
		},
		"transformIgnorePatterns": [
			"node_modules/(?!.pnpm/(@t3-oss\\+env-core|@t3-oss\\+env-nextjs)|@t3-oss/env-core)"
		],
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"coverageThreshold": {
			"global": {
				"lines": 25,
				"functions": 20,
				"branches": 20,
				"statements": 25
			}
		},
		"coveragePathIgnorePatterns": [
			"<rootDir>/modules/v1/examples/"
		],
		"testEnvironment": "node",
		"testTimeout": 30000,
		"moduleNameMapper": {
			"^@repo/contracts/pisocamp-assets$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/asset.schema.ts",
			"^@repo/contracts/pisocamp-preview$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/preview.schema.ts",
			"^@repo/contracts/pisocamp-version-history$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/version-history.schema.ts",
			"^@repo/contracts/pisocamp-content-audit$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/content-audit.schema.ts",
			"^@repo/contracts/pisocamp-content$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/content.schema.ts",
			"^@repo/contracts/pisocamp-adoption$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/adoption.schema.ts",
			"^@repo/contracts/pisocamp-gamification$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/gamification.schema.ts",
			"^@repo/contracts/pisocamp-survey-metrics$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/survey-metrics.schema.ts",
			"^@repo/contracts/pisocamp-technical$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/technical.schema.ts",
			"^@repo/contracts/pisocamp-demographics$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/demographics.schema.ts",
			"^@repo/contracts/pisocamp-acquisition$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/acquisition.schema.ts",
			"^@repo/contracts/pisocamp-push$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/push.schema.ts",
			"^@repo/contracts/pisocamp-progress$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/progress.schema.ts",
			"^@repo/contracts/pisocamp-leaderboard$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/leaderboard.schema.ts",
			"^@repo/contracts/pisocamp-data-subject$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/data-subject.schema.ts",
			"^@repo/contracts/pisocamp-config$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/pisocamp.schema.ts",
			"^@repo/contracts/pisocamp-account$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/account.schema.ts",
			"^@repo/contracts/pisocamp-role$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/role.schema.ts",
			"^@repo/contracts/pisocamp-recognition$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/recognition.schema.ts",
			"^@repo/contracts/pisocamp-report$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/report.schema.ts",
			"^@repo/contracts/pisocamp-retention$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/retention.schema.ts",
			"^@repo/contracts/pisocamp-analytics$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/analytics.schema.ts",
			"^@repo/contracts/pisocamp-survey-response$": "<rootDir>/../../../packages/contracts/src/modules/v1/pisocamp/survey-response.schema.ts",
			"^@repo/db/(.*)$": "<rootDir>/../../../packages/db/src/$1",
			"^@repo/auth/(.*)$": "<rootDir>/../../../packages/auth/src/$1",
			"^@repo/contracts$": "<rootDir>/../../../packages/contracts/src",
			"^@repo/observability$": "<rootDir>/../../../packages/observability/src/index.ts",
			"^@/(.*)$": "<rootDir>/$1",
			"^(\\.{1,2}/.*)\\.js$": "$1"
		},
		"setupFiles": [
			"<rootDir>/../jest.setup.ts"
		]
	}
}
