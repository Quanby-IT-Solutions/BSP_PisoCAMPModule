<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for anonymous signed Piso CAMP bundle synchronization. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Awesome Notifications: permission to post notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Awesome Notifications: vibration support -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- AR-001. Requested at runtime, and only after the module has explained
         on screen why it is needed. Merged in by flutter_sceneview as well;
         declared here so the app's own manifest says what it asks for. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <!-- Awesome Notifications: exact alarms for scheduled notifications (Android 12+) -->

    <!-- Awesome Notifications: re-schedule after device reboot -->

    <application
        android:label="Piso CAMP"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- F5. The custom scheme only an installed app can answer. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="bsp" android:host="pisocamp"/>
            </intent-filter>
            <!-- F5. The App Link an installed app intercepts and a browser
                 otherwise follows to the BSP page, which is what makes the
                 "app not installed" fallback work at all: the operating system
                 cannot run code that is not on the device.
                 autoVerify requires the matching assetlinks.json to be served
                 from https://www.bsp.gov.ph/.well-known/. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="www.bsp.gov.ph"
                    android:pathPrefix="/pisocamp"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- F5. Hands an incoming link to the Flutter router rather than to a
             platform channel, so one resolver decides what every link means. -->
        <meta-data
            android:name="flutter_deeplinking_enabled"
            android:value="true" />
        <!-- AR-001. "optional", not "required": a phone without ARCore must
             still install and run this app, because Piso CAMP is a currency
             education module first and an AR experience second. Marking it
             required would hide the app from every device that cannot do AR
             and strand them from the 3D viewer that AR falls back to.
             MainActivity asks ArCoreApk at runtime instead. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
