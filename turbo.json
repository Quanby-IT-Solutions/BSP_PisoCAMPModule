{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"topo": {
			"dependsOn": ["^topo"]
		},
		"build": {
			"dependsOn": ["^build", "^lint", "^typecheck"],
			"outputs": [".cache/tsbuildinfo.json", "dist/**"],
			"cache": true
		},
		"dev": {
			"cache": false,
			"persistent": false
		},
		"start": {
			"dependsOn": ["^build", "build"],
			"cache": false,
			"persistent": true
		},
		"format": {
			"outputs": [".cache/.prettiercache"],
			"outputLogs": "new-only"
		},
		"lint": {
			"dependsOn": ["^topo", "^build"],
			"outputs": [".cache/.eslintcache"],
			"cache": true
		},
		"typecheck": {
			"dependsOn": ["^topo", "^build"],
			"outputs": [".cache/tsbuildinfo.json"],
			"cache": true
		},
		"test": {
			"dependsOn": ["^build", "^test"],
			"cache": true,
			"outputs": ["coverage/**"],
			// Turbo runs tasks in a stripped environment, so the suites that need a
			// live disposable PostgreSQL never saw the variables that let them run:
			// exporting them had no effect, and `turbo test` failed on every
			// machine. Listed under `env` rather than `passThroughEnv` so pointing
			// at a different database also invalidates the cached result.
			"env": [
				"DATABASE_URL",
				"ALLOW_DESTRUCTIVE_DATABASE_TESTS",
				"PISOCAMP_BUNDLE_TEST_DATABASE_URL",
				"RUN_CM2_TASK2_DB_MIGRATION_TESTS",
				"CM2_TASK2_DATABASE_URL"
			]
		},
		"test:cov": {
			"dependsOn": ["^build", "^test:cov"],
			"cache": true,
			"outputs": ["coverage/**"],
			"env": [
				"DATABASE_URL",
				"ALLOW_DESTRUCTIVE_DATABASE_TESTS",
				"PISOCAMP_BUNDLE_TEST_DATABASE_URL",
				"RUN_CM2_TASK2_DB_MIGRATION_TESTS",
				"CM2_TASK2_DATABASE_URL"
			]
		},
		"test:e2e": {
			"cache": false,
			"persistent": false,
			"passThroughEnv": ["PLAYWRIGHT_*", "BASE_URL", "BACKEND_URL", "E2E_TEST_EMAIL", "E2E_TEST_PASSWORD", "E2E_TEST_NAME"]
		},
		"clean": {
			"cache": false
		},
		"push": {
			"cache": false,
			"interactive": true
		},
		"studio": {
			"cache": false,
			"persistent": true
		}
	},
	"globalEnv": [],
	"globalPassThroughEnv": [
		"NODE_ENV",
		"CI",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_URL",
		"npm_lifecycle_event",
		"LOCALAPPDATA",
		"PUB_CACHE"
	]
}
